from __future__ import annotations

"""Stage S08 Local – HIGH-PERFORMANCE Drug Enrichment using Local CID-Synonym Index + RxNav API.

Logic Flow:
1. STEP 1: Try RxNav API directly with original drug name
   - If found → SUCCESS (rxnav_exact)
   - If 404/not found → go to Step 2

2. STEP 2: Local CID-Synonym Fallback
   - Query local index for alternative names/synonyms (HIGH-PERFORMANCE grep -F -f)
   - For each alternative name → try RxNav API again
   - If any alternative works → SUCCESS (local_fallback)
   - If all alternatives fail → NOT FOUND

3. STEP 3: Get Ingredients (if RxCUI found)
   - Fetch ingredient details from RxNav API
   - Store complete drug information

Features:
- ✅ No PubChem API calls (100% Local Index)
- ✅ Intelligent fallback using drug synonyms
- ✅ RxNav API rate limiting (10 req/s with API Key)
- ✅ HIGH-PERFORMANCE grep optimization
"""

import asyncio
import os
import subprocess
from dataclasses import dataclass
from pathlib import Path
from typing import Dict, List, Optional, Set

import aiohttp
import polars as pl
from loguru import logger
from tqdm import tqdm

from src.adapters.rxnorm import RxNormClient
from src.utils.io import PipelineContext, stage_output_path, write_manifest

# NCBI API Key (Used ONLY for RxNav API rate limit increase, NOT for PubChem)
NCBI_API_KEY = "2f59af6ca759dbfd1ab61a775437be88a609"

# Rate limiting: 10 concurrent requests (Safe for RxNav with API Key)
RATE_LIMIT_SEMAPHORE = asyncio.Semaphore(10)


class PubChemLocalIndex:
    """Ultra-fast PubChem CID-Synonym index using DuckDB for millisecond queries."""

    def __init__(self, cid_file_path: Optional[str] = None):
        self.cid_file_path = cid_file_path or "data/CID-Synonym-filtered"

        # DuckDB in-memory connection (fastest for our use case)
        self._con = duckdb.connect(database=':memory:')

        # Configure DuckDB for optimal performance (quiet mode)
        self._con.execute("PRAGMA threads=4")  # Use 4 threads
        self._con.execute("PRAGMA memory_limit='2GB'")  # 2GB memory limit
        self._con.execute("SET enable_progress_bar=false")  # Disable progress bars
        # Disable all verbose logging
        import logging
        logging.getLogger('duckdb').setLevel(logging.ERROR)

        # Filtered loading setup
        self._filtered_mode = False
        self._drug_names_to_load: Set[str] = set()

        # In-memory indexes (built after DuckDB query)
        self.name_to_cid: Dict[str, int] = {}
        self.cid_to_synonyms: Dict[int, Set[str]] = {}
        self._loaded = False

    def set_drug_names_to_load(self, drug_names: List[str]) -> None:
        """Set drug names to load (filtered loading mode)."""
        self._filtered_mode = True
        self._drug_names_to_load = {
            name.strip() for name in drug_names if name and name.strip()
        }
        logger.info(f"[LocalIndex] DuckDB filtered loading mode set for {len(self._drug_names_to_load)} unique drug names")

    def load_index(self) -> None:
        """Load and build the CID-Synonym index using DuckDB."""
        if self._loaded:
            logger.info("[LocalIndex] Index already loaded")
            return

        if self._filtered_mode:
            self._load_filtered_duckdb()
        else:
            logger.warning("[LocalIndex] Loading FULL index is not recommended. Use filtered mode.")

        self._loaded = True

    def _load_filtered_duckdb(self) -> None:
        """Ultra-fast filtered index loading using DuckDB SQL queries."""
        if not self._drug_names_to_load:
            logger.warning("[LocalIndex] No drug names to load")
            return

        cid_file = Path(self.cid_file_path)
        if not cid_file.exists():
            raise FileNotFoundError(f"CID-Synonym file not found: {self.cid_file_path}")

        try:
            logger.info(f"[LocalIndex] 🚀 DuckDB loading {len(self._drug_names_to_load)} drug names...")

            # STEP 1: Load drug names into DuckDB temp table
            drug_names_list = list(self._drug_names_to_load)
            drug_names_df = pl.DataFrame({"drug_name": drug_names_list})

            # Register as DuckDB table
            self._con.register("drug_names", drug_names_df)

            # STEP 2: Create table and load data manually for better control
            logger.info("[LocalIndex] Creating DuckDB table and loading data...")

            # Create empty table first
            self._con.execute("""
                CREATE TABLE cid_synonyms (
                    cid INTEGER,
                    synonym VARCHAR
                )
            """)

            # Load data in batches for memory efficiency
            batch_size = 50000
            batch_data = []

            with open(cid_file, 'r', encoding='utf-8') as f:
                for i, line in enumerate(f):
                    line = line.strip()
                    if not line:
                        continue

                    # Parse line manually (handle Tab or Space)
                    if '\t' in line:
                        parts = line.split('\t', 1)
                    else:
                        parts = line.split(None, 1)

                    if len(parts) >= 2:
                        try:
                            cid = int(parts[0].strip())
                            synonym = parts[1].strip()

                            batch_data.append((cid, synonym))

                            # Insert batch
                            if len(batch_data) >= batch_size:
                                self._con.executemany(
                                    "INSERT INTO cid_synonyms VALUES (?, ?)",
                                    batch_data
                                )
                                batch_data = []

                        except ValueError:
                            continue  # Skip malformed lines

                # Insert remaining data
                if batch_data:
                    self._con.executemany(
                        "INSERT INTO cid_synonyms VALUES (?, ?)",
                        batch_data
                    )

            # STEP 3: Execute ultra-fast SQL query for reverse lookup
            logger.info("[LocalIndex] Executing reverse lookup SQL query...")

            # This SQL does both MATCH + EXPAND in one query:
            # 1. Find CIDs where synonyms match our drug names (case insensitive)
            # 2. For those CIDs, get ALL synonyms (not just the matching ones)
            result = self._con.execute("""
                WITH matching_cids AS (
                    -- Find CIDs that have synonyms matching our drug names
                    SELECT DISTINCT cs.cid
                    FROM cid_synonyms cs
                    JOIN drug_names dn ON LOWER(TRIM(cs.synonym)) = LOWER(TRIM(dn.drug_name))
                )
                -- For all matching CIDs, get ALL their synonyms (complete expansion)
                SELECT cs.cid, cs.synonym
                FROM cid_synonyms cs
                WHERE cs.cid IN (SELECT cid FROM matching_cids)
                ORDER BY cs.cid, cs.synonym
            """).fetchall()

            # STEP 4: Build in-memory indexes from results
            logger.info(f"[LocalIndex] Building indexes from {len(result)} result rows...")

            # Pre-allocate for performance
            name_to_cid_temp = {}
            cid_to_synonyms_temp = {}

            for cid, synonym in result:
                # Clean and normalize
                synonym_clean = synonym.strip()
                synonym_lower = synonym_clean.lower()

                # Build name_to_cid (all synonyms point to their CID)
                name_to_cid_temp[synonym_lower] = cid

                # Build cid_to_synonyms (group synonyms by CID)
                if cid not in cid_to_synonyms_temp:
                    cid_to_synonyms_temp[cid] = set()
                cid_to_synonyms_temp[cid].add(synonym_clean)

            # Assign to instance variables
            self.name_to_cid = name_to_cid_temp
            self.cid_to_synonyms = cid_to_synonyms_temp

            logger.info(f"[LocalIndex] ✅ DuckDB index built: {len(self.name_to_cid):,} names, {len(self.cid_to_synonyms):,} CIDs")

            # Cleanup: drop temp tables to free memory
            self._con.execute("DROP TABLE IF EXISTS cid_synonyms")
            self._con.execute("DROP TABLE IF EXISTS drug_names")

        except Exception as e:
            logger.error(f"[LocalIndex] DuckDB loading failed: {e}")
            # Fallback to empty indexes
            self.name_to_cid = {}
            self.cid_to_synonyms = {}

    def find_cid_by_name(self, name: str) -> Optional[int]:
        """Find CID by drug name (O(1) lookup)."""
        if not self._loaded:
            self.load_index()
        return self.name_to_cid.get(name.lower().strip())

    def find_candidate_names(self, name: str) -> List[str]:
        """Find candidate names (synonyms) for a drug."""
        if not self._loaded:
            self.load_index()

        cid = self.find_cid_by_name(name)
        if cid is None:
            return []

        synonyms = self.cid_to_synonyms.get(cid, set())
        original_lower = name.lower().strip()

        # Return synonyms excluding the original name
        candidates = [s for s in synonyms if s.lower().strip() != original_lower]
        return sorted(candidates)

    def __del__(self):
        """Cleanup DuckDB connection."""
        if hasattr(self, '_con') and self._con:
            self._con.close()

@dataclass
class EnrichmentResult:
    rxcui: Optional[str] = None
    rxcui_tty: Optional[str] = None
    ingredients: List[str] = None
    ingredient_count: int = 0
    source: str = "not_found"

    def __post_init__(self):
        if self.ingredients is None:
            self.ingredients = []

EnrichmentCache = Dict[str, EnrichmentResult]


async def _enrich_names_local(
    ctx: PipelineContext,
    names: List[str],
    cache: EnrichmentCache,
    *,
    local_index: PubChemLocalIndex,
    label: Optional[str] = None,
) -> EnrichmentCache:
    
    # Headers for RxNav (using API key for higher rate limit)
    headers = {
        "User-Agent": "DrugPipeline/1.0 (mailto:tttccc4589@gmail.com)",
        "api-key": NCBI_API_KEY,
        "Accept": "application/json",
    }

    connector = aiohttp.TCPConnector(limit=15, ttl_dns_cache=300)
    timeout = aiohttp.ClientTimeout(total=30)

    async with aiohttp.ClientSession(connector=connector, timeout=timeout, headers=headers) as session:
        client = RxNormClient(ctx, session)
        results = {}

        async def handle(name: str) -> None:
            try:
                rxcui: Optional[str] = None
                source = "not_found"

                # STEP 1: RxNav Exact Match
                async with RATE_LIMIT_SEMAPHORE:
                    try:
                        candidates = await client.lookup_exact(name)
                        if candidates:
                            rxcui = candidates[0]
                            source = "rxnav_exact"
                    except Exception:
                        pass

                # STEP 2: Local Fallback (Only if Step 1 failed)
                if not rxcui:
                    candidates = local_index.find_candidate_names(name)
                    
                    if candidates:
                        # Try candidates (Limit to top 5)
                        for cand in candidates[:5]:
                            try:
                                async with RATE_LIMIT_SEMAPHORE:
                                    res = await client.lookup_exact(cand)
                                    if res:
                                        rxcui = res[0]
                                        source = "local_fallback"
                                        break
                            except Exception:
                                continue
                            await asyncio.sleep(0.05)

                # STEP 3: Get Ingredients
                ingredients = []
                rxcui_tty = None
                if rxcui:
                    try:
                        async with RATE_LIMIT_SEMAPHORE:
                            info_list = await client.get_related_ingredients(rxcui)
                            ingredients = sorted(list(set(i.name for i in info_list)))
                            ttys = set(i.tty for i in info_list)
                            rxcui_tty = "IN" if "IN" in ttys else ("MIN" if "MIN" in ttys else None)
                    except Exception:
                        pass

                results[name] = EnrichmentResult(rxcui, rxcui_tty, ingredients, len(ingredients), source)

            except Exception as e:
                logger.error(f"Error enriching '{name}': {e}")
                results[name] = EnrichmentResult(source="error")

        # Execution Loop
        tasks = [asyncio.create_task(handle(name)) for name in names]
        desc = f"S08-Local {label}" if label else "S08-Local"
        
        # Progress Bar
        for fut in tqdm(asyncio.as_completed(tasks), total=len(tasks), desc=desc, ncols=100, colour='blue'):
            await fut

        # Combine results logic is handled inside handle() updating results dict
        # but results dict is local to _enrich_names_local scope?
        # WAIT: handle() writes to 'results' dict which is in scope. Correct.
        
        return results


def run(ctx: PipelineContext) -> None:
    """Run Stage S08 Local."""
    source_dir = stage_output_path(ctx, "s07b_llm_clean")
    output_dir = stage_output_path(ctx, "s08_enrich_drug_identifiers")
    output_dir.mkdir(parents=True, exist_ok=True)

    # Init Local Index
    # Updated default path to what you confirmed: data/CID-Synonym-filtered
    cid_file = "data/CID-Synonym-filtered"
    local_index = PubChemLocalIndex(cid_file_path=cid_file)

    global_cache: EnrichmentCache = {}

    target_cohort = os.environ.get("TARGET_COHORT")
    cohorts = [target_cohort] if target_cohort else ["pediatric", "adult"]

    for cohort in cohorts:
        source = source_dir / f"{cohort}_drugs_clean.parquet"
        if not source.exists():
            logger.warning(f"Source file not found for {cohort}: {source}")
            continue

        df = pl.read_parquet(source)
        logger.info(f"Loaded {cohort} data: {df.shape}")

        # Extract unique names
        if df["medicinal_product_llm_clean"].dtype == pl.List(pl.Utf8):
            unique_names = df.select(pl.col("medicinal_product_llm_clean").explode()).unique().drop_nulls().to_series().to_list()
        else:
            unique_names = df["medicinal_product_llm_clean"].unique().drop_nulls().to_list()

        logger.info(f"Unique drugs to enrich: {len(unique_names)}")
        
        # Preload Index (Optimized)
        local_index.set_drug_names_to_load(unique_names)
        local_index.load_index()

        # Run Enrichment
        results = asyncio.run(_enrich_names_local(ctx, unique_names, global_cache, local_index=local_index, label=cohort))
        global_cache.update(results)

        # Build Output DataFrame
        rows = []
        for name in unique_names:
            res = global_cache.get(name, EnrichmentResult())
            rows.append({
                "name": name,
                "rxcui": res.rxcui,
                "rxcui_tty": res.rxcui_tty,
                "ingredients": res.ingredients,
                "ingredient_count": res.ingredient_count
            })
        
        map_df = pl.DataFrame(rows)
        
        # Save mapping
        map_out = output_dir / f"{cohort}_drugs_enriched.parquet"
        map_df.write_parquet(map_out)
        
        # Calculate stats
        found = map_df.filter(pl.col("rxcui").is_not_null()).height
        if len(unique_names) > 0:
            logger.success(f"Cohort {cohort}: {found}/{len(unique_names)} ({(found/len(unique_names)*100):.1f}%) coverage")
        else:
            logger.warning(f"Cohort {cohort}: No unique names found.")

    write_manifest(ctx, "s08_enrich_drug_identifiers_local", {"status": "success"})