# Copy to .env in the repository root (never commit .env):
#   cp .env.example .env
#
# Keys are read via python-dotenv (loaded when `src.settings` is imported)
# and/or shell `source .env` in scripts/step1_s01_fetch.sh

# --- OpenFDA (S01 fetch) — https://open.fda.gov/apis/authentication/
OPENFDA_API_KEY=

# --- NCBI / PubChem (S08 enrichment; optional, higher rate limits)
# https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# --- OpenAI / OpenAI-compatible API (optional scripts, e.g. scripts/s07_openai_run.py)
OPENAI_API_KEY=
# S07_API_BASE_URL=http://127.0.0.1:8000/v1
# S07_API_KEY=
# S07_MODEL_NAME=Qwen/Qwen2.5-32B-Instruct

# --- Hugging Face (S10 dataset upload, HF model cache)
# HF_TOKEN=
